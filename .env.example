# ---------------------------------------------------------------------------
# ai-lead-qualifier-n8n – environment
# Copy to .env (`make setup` does this and generates the random secrets).
# Never commit .env. Values marked CHANGE_ME must be filled before the step
# that needs them; the mock server covers Tavily/Gemini until then.
# ---------------------------------------------------------------------------

# --- n8n core -------------------------------------------------------------
# Encrypts every credential stored in n8n. Generated by `make setup`.
# Keep it safe: losing it makes stored credentials unreadable.
N8N_ENCRYPTION_KEY=CHANGE_ME_GENERATED
# Public host name of the editor (localhost for dev, tunnel host for demos)
N8N_HOST=localhost
# Host port for the editor (n8n itself listens on 5678 inside the container)
N8N_HOST_PORT=5678
N8N_PROTOCOL=http
# Base URL n8n uses for webhook and form URLs. Set to the `make tunnel` URL when
# demoing. (n8n 2.x renamed WEBHOOK_URL to N8N_WEBHOOK_URL.)
N8N_WEBHOOK_URL=http://localhost:5678/
GENERIC_TIMEZONE=Europe/London

# Owner account, created from env on first boot (no clicking through setup).
N8N_INSTANCE_OWNER_MANAGED_BY_ENV=true
N8N_INSTANCE_OWNER_EMAIL=owner@example.test
N8N_INSTANCE_OWNER_FIRST_NAME=Lead
N8N_INSTANCE_OWNER_LAST_NAME=Pilot
# Plain password, only used by the local admin scripts to log in. Generated by `make setup`.
N8N_OWNER_PASSWORD=CHANGE_ME_GENERATED
# bcrypt hash of N8N_OWNER_PASSWORD (generated by `make setup`). Single quotes keep the $ signs literal.
N8N_INSTANCE_OWNER_PASSWORD_HASH='CHANGE_ME_GENERATED'

# n8n public API key, used by `make credentials`, `make eval` and the e2e tests.
# Leave empty: the admin scripts create one from the owner login when needed.
# Or create one in n8n: Settings -> n8n API.
N8N_API_KEY=

# Shared secret between n8n and the task-runners container. Generated by `make setup`.
N8N_RUNNERS_AUTH_TOKEN=CHANGE_ME_GENERATED

# --- n8n database (Postgres) ---------------------------------------------
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
DB_POSTGRESDB_PASSWORD=CHANGE_ME_GENERATED

# --- execution data pruning (keeps personal data out of long-lived logs) --
EXECUTIONS_DATA_PRUNE=true
# Hours; 336 h = 14 days
EXECUTIONS_DATA_MAX_AGE=336

# --- LeadPilot leads database (same Postgres server, separate database) ---
# Holds the idempotency ledger and lead statuses. Rows (incl. name/email) are
# purged after LEAD_RETENTION_DAYS by the daily workflow; HubSpot keeps the record.
LEADPILOT_DB_NAME=leadpilot
LEAD_RETENTION_DAYS=30

# --- LLM: Google Gemini ---------------------------------------------------
# Key: https://aistudio.google.com/app/apikey (free tier; free-tier data may be
# used by Google, so only synthetic/public data goes through it)
GEMINI_API_KEY=CHANGE_ME
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
LLM_MODEL=gemini-2.5-flash

# --- Web research: Tavily ------------------------------------------------
# Key: https://app.tavily.com (free tier: 1,000 credits/month)
TAVILY_API_KEY=CHANGE_ME
TAVILY_BASE_URL=https://api.tavily.com

# --- CRM: HubSpot ---------------------------------------------------------
# Private app token: HubSpot -> Settings -> Integrations -> Private Apps.
# Scopes (least privilege): crm.objects.contacts.read, crm.objects.contacts.write,
# crm.objects.companies.read, crm.objects.companies.write, crm.schemas.contacts.read,
# crm.schemas.contacts.write (for `make hubspot-setup`). Notes and tasks are covered by
# the contacts scopes. See README "HubSpot setup".
HUBSPOT_PRIVATE_APP_TOKEN=CHANGE_ME
# API base URL (tests point it at the mock server)
HUBSPOT_BASE_URL=https://api.hubapi.com

# --- Slack -----------------------------------------------------------------
# https://api.slack.com/apps -> your app -> OAuth & Permissions. Bot token scopes:
# chat:write (post approval requests, reminders, alerts, digest). Invite the bot to both channels.
SLACK_BOT_TOKEN=CHANGE_ME
# Optional: only needed if you add Slack interactivity later (approvals use an n8n form link).
SLACK_SIGNING_SECRET=CHANGE_ME
# API base URL (tests point it at the mock server)
SLACK_BASE_URL=https://slack.com/api
# Channel IDs (right-click channel -> View channel details -> ID at the bottom)
SLACK_APPROVAL_CHANNEL=CHANGE_ME
SLACK_ALERTS_CHANNEL=CHANGE_ME

# --- Email (SMTP; Gmail needs an app password) ----------------------------
# Gmail app password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=CHANGE_ME
SMTP_PASSWORD=CHANGE_ME
# true for port 465 (implicit TLS); false for 587 (STARTTLS) or a local test server
SMTP_SECURE=true
EMAIL_FROM="Northwind Digital <you@example.com>"

# --- Business settings ----------------------------------------------------
BOOKING_LINK=https://northwind.example/book
FOLLOW_UP_DAYS=3
APPROVAL_TIMEOUT_HOURS=24
APPROVAL_REMINDER_HOURS=4

# --- Webhook intake -------------------------------------------------------
# Shared secret for the X-Signature-256 header (HMAC-SHA256 of the raw body).
# Generated by `make setup`; give the same value to the form tool.
WEBHOOK_HMAC_SECRET=CHANGE_ME_GENERATED

# Token for the ops webhook (POST /webhook/ops: replay a lead, run the digest or reminders
# now). Header: X-LeadPilot-Ops-Token. Generated by `make setup`.
OPS_WEBHOOK_TOKEN=CHANGE_ME_GENERATED

# --- Modes ---------------------------------------------------------------
# Demo mode: emails only go to DEMO_EMAIL_ALLOWLIST, eval auto-approve allowed.
DEMO_MODE=true
# Comma-separated addresses or @domains allowed to receive email in demo mode
DEMO_EMAIL_ALLOWLIST=you+demo@example.com
# Skip real HubSpot, Slack and email writes (tests/CI)
DRY_RUN=false
# Auto-approve drafts (only honoured when DEMO_MODE=true); used by `make eval`
EVAL_AUTO_APPROVE=false

# --- Test harness ------------------------------------------------------------
# Where the pytest suite reaches n8n and the mock server from the host
N8N_URL=http://localhost:5678
MOCK_URL=http://localhost:8099
# Test SMTP inbox (mailpit, test profile)
# Host port for the test inbox
MAILPIT_HOST_PORT=8025
MAILPIT_URL=http://localhost:8025
