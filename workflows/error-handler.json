            "index": 0
          }
        ]
      ]
    },
    "Describe failure": {
      "main": [
        [
          {
            "node": "Report it?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Report it?": {
      "main": [
        [
          {
            "node": "Send alert",
            "type": "main",
            "index": 0
          }
        ],
        []
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "timezone": "Europe/London",
    "callerPolicy": "workflowsFromSameOwner"
  },
  "staticData": null,
