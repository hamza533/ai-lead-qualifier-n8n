    {
      "id": "b4e1f2a3-6d9e-4f3a-b14c-000000000002",
      "name": "Claim lead for replay",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        200
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "postgres": {
          "id": "lpCredLeadsDb001",
          "name": "LeadPilot DB"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Only leads left in error_recoverable can be replayed. A lead that already has its\n-- decision (or is cold) resumes at finish-lead, so nothing is drafted or sent twice;\n-- any other lead restarts the pipeline from the stored normalised lead.\nUPDATE leads SET\n  status = CASE WHEN decision IS NOT NULL OR tier = 'cold' THEN 'finishing' ELSE 'received' END,\n  error = NULL, updated_at = now()\nWHERE lead_id = $1 AND status = 'error_recoverable' AND payload IS NOT NULL\nRETURNING lead_id, payload, (decision IS NOT NULL OR tier = 'cold') AS resume;",
        "options": {
          "queryReplacement": "={{ [String($('Ops webhook').first().json.body.lead_id ?? '')] }}"
        }
      },
      "alwaysOutputData": true
    },
    {
      "id": "b4e1f2a3-6d9e-4f3a-b14c-000000000005",
      "name": "Recoverable lead found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        700,
        200
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "b4e1f2a3-6d9e-4f3a-b14c-000000000004",
              "leftValue": "={{ Boolean($json.lead_id) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
