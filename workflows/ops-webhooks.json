    {
      "id": "b4e1f2a3-6d9e-4f3a-b14c-000000000007",
      "name": "Prepare replay",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        40
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Start the pipeline with the lead exactly as it was accepted.\nconst row = $('Claim lead for replay').first().json;\nconst lead = typeof row.payload === 'string' ? JSON.parse(row.payload) : row.payload;\nreturn [{ json: { check: 'accepted', lead, replay: true } }];"
      }
    },
