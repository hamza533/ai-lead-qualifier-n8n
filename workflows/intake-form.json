{
  "id": "lpIntakeForm0001",
  "name": "LeadPilot – Intake: hosted form",
  "description": null,
  "active": true,
  "nodes": [
    {
      "id": "6f1d0a52-1c55-4b1e-9d1a-0c1f2a000001",
      "name": "Lead form",
      "type": "n8n-nodes-base.formTrigger",
      "typeVersion": 2.6,
      "position": [
        0,
        0
      ],
      "webhookId": "6f1d0a52-1c55-4b1e-9d1a-0c1f2a0f0001",
      "parameters": {
        "formTitle": "Talk to Northwind Digital",
        "formDescription": "Tell us about your project. We reply within one business day.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Name",
              "fieldName": "name",
              "fieldType": "text",
              "requiredField": true,
              "placeholder": "Daniel Reyes"
            },
            {
              "fieldLabel": "Work email",
              "fieldName": "email",
              "fieldType": "email",
              "requiredField": true,
              "placeholder": "you@company.com"
            },
            {
              "fieldLabel": "Company",
              "fieldName": "company",
              "fieldType": "text",
              "requiredField": true
            },
            {
              "fieldLabel": "Website",
              "fieldName": "website",
              "fieldType": "text",
              "placeholder": "https://"
            },
            {
              "fieldLabel": "Role",
              "fieldName": "role",
              "fieldType": "text",
              "placeholder": "Head of Operations"
            },
            {
              "fieldLabel": "Budget range",
              "fieldName": "budget_range",
              "fieldType": "dropdown",
              "fieldOptions": {
                "values": [
                  {
                    "option": "Not sure yet"
                  },
                  {
                    "option": "Under $5k"
                  },
                  {
                    "option": "$5k-$20k"
                  },
                  {
                    "option": "$20k-$50k"
                  },
                  {
                    "option": "$50k-$150k"
                  },
                  {
                    "option": "Over $150k"
                  }
                ]
              }
            },
            {
              "fieldLabel": "Message",
              "fieldName": "message",
              "fieldType": "textarea",
              "requiredField": true,
              "placeholder": "What do you need, and by when?"
            },
            {
              "fieldName": "website_url_confirm",
              "fieldType": "hiddenField",
              "fieldValue": ""
            }
          ]
        },
        "responseMode": "onReceived",
        "options": {
          "path": "lead-form",
          "appendAttribution": false,
          "buttonLabel": "Send",
          "ignoreBots": true,
          "respondWithOptions": {
            "values": {
              "respondWith": "text",
              "formSubmittedText": "Thanks! We reply within one business day."
            }
          }
        }
      }
    },
    {
      "id": "6f1d0a52-1c55-4b1e-9d1a-0c1f2a000002",
      "name": "Map form submission",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Hosted n8n form: no signature needed, fields arrive by name.\nconst f = $input.first().json;\nreturn [{ json: { source: 'form', fields: {\n  name: f.name, email: f.email, company: f.company, website: f.website, role: f.role,\n  budget_range: f.budget_range, message: f.message, website_url_confirm: f.website_url_confirm,\n} } }];"
      }
    },
    {
      "id": "7a2e0b63-2d66-4c2f-8e2b-1d2f3b000040",
