    {
      "id": "9d4a2e85-4b7c-4d1e-9f2a-000000000002",
      "name": "Record enrichment",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        480,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000,
      "credentials": {
        "postgres": {
          "id": "lpCredLeadsDb001",
          "name": "LeadPilot DB"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Keep the research with the lead; a failed enrichment is a recoverable status,\n-- the lead continues and is scored on form data only.\nUPDATE leads SET\n  enrichment_status = $2,\n  status = CASE WHEN $2 = 'failed' THEN 'enrichment_failed' ELSE 'enriched' END,\n  enrichment = $3::jsonb,\n  error = NULLIF($4, ''),\n  llm_input_tokens = llm_input_tokens + $5::int,\n  llm_output_tokens = llm_output_tokens + $6::int,\n  tavily_credits = tavily_credits + $7::int,\n  updated_at = now()\nWHERE lead_id = $1\nRETURNING lead_id, status;",
        "options": {
          "queryReplacement": "={{ [$('Lead accepted').first().json.lead.lead_id, $json.enrichment_status, JSON.stringify({ note: $json.enrichment_note, profile: $json.profile, sources: $json.sources, grounding: $json.grounding }), ($json.errors || []).join('; '), $json.usage.llm_input_tokens, $json.usage.llm_output_tokens, $json.usage.tavily_credits] }}"
        }
      }
    },
    {
      "id": "b2c3d4e5-5c8d-4e2f-a03b-000000000001",
      "name": "Bundle lead + research",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Hand the scorer the lead and its research (the previous node only returned the row).\nreturn [{ json: {\n  lead: $('Lead accepted').first().json.lead,\n  enrichment: $('Enrich company').first().json,\n} }];"
      }
    },
    {
      "id": "b2c3d4e5-5c8d-4e2f-a03b-000000000002",
      "name": "Score lead",
      "type": "n8n-nodes-base.executeWorkflow",
