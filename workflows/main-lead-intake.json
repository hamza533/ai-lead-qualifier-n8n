    },
    {
      "id": "b2c3d4e5-5c8d-4e2f-a03b-000000000003",
      "name": "Record score",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [
        1200,
        0
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "credentials": {
        "postgres": {
          "id": "lpCredLeadsDb001",
          "name": "LeadPilot DB"
        }
      },
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE leads SET\n  score = $2::int,\n  tier = $3,\n  status = 'scored',\n  scoring = $4::jsonb,\n  llm_input_tokens = llm_input_tokens + $5::int,\n  llm_output_tokens = llm_output_tokens + $6::int,\n  updated_at = now()\nWHERE lead_id = $1\nRETURNING lead_id, score, tier;",
        "options": {
          "queryReplacement": "={{ [$('Lead accepted').first().json.lead.lead_id, $json.score, $json.tier, JSON.stringify({ criteria: $json.criteria, thresholds: $json.thresholds, issues: $json.issues }), $json.usage.llm_input_tokens, $json.usage.llm_output_tokens] }}"
        }
      }
    },
