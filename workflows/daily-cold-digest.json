          }
        ],
        [
          {
            "node": "Post digest",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dry run: skip post": {
      "main": [
        [
          {
            "node": "Digest result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Post digest": {
      "main": [
        [
          {
            "node": "Check digest reply",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check digest reply": {
      "main": [
        [
          {
            "node": "Digest result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "errorWorkflow": "lpErrorHandler01",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "timezone": "Europe/London",
