        }
      }
    },
    {
      "id": "6f1d0a52-1c55-4b1e-9d1a-0c1f2a000004",
      "name": "Verify HMAC signature",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Webhook senders sign the raw request body:\n//   X-Signature-256: sha256=<hex HMAC-SHA256(body, WEBHOOK_HMAC_SECRET)>\nconst crypto = require('crypto');\nconst item = $input.first();\nconst secret = $env.WEBHOOK_HMAC_SECRET || '';\nconst header = String((item.json.headers || {})['x-signature-256'] || '');\nconst given = header.startsWith('sha256=') ? header.slice(7) : '';\n\nlet raw = Buffer.alloc(0);\nif (item.binary && item.binary.data) {\n  raw = await this.helpers.getBinaryDataBuffer(0, 'data');\n}\nconst expected = crypto.createHmac('sha256', secret).update(raw).digest('hex');\nconst valid = secret.length >= 16 && /^[0-9a-f]{64}$/i.test(given) &&\n  crypto.timingSafeEqual(Buffer.from(given.toLowerCase(), 'hex'), Buffer.from(expected, 'hex'));\n\nlet fields = {};\nif (valid) {\n  try { fields = JSON.parse(raw.toString('utf8')); } catch (e) { fields = {}; }\n}\nreturn [{ json: { source: fields._eval === true ? 'eval' : 'webhook', signature_valid: valid, fields } }];"
      }
    },
    {
      "id": "6f1d0a52-1c55-4b1e-9d1a-0c1f2a000005",
      "name": "Signature valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "b1",
              "leftValue": "={{ $json.signature_valid }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "6f1d0a52-1c55-4b1e-9d1a-0c1f2a000006",
      "name": "Respond 401",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        660,
